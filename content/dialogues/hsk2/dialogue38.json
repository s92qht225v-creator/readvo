      "sentences": [
        {
          "id": "d38-s1",
          "text_original": "你好，我要一杯咖啡。",
          "pinyin": "Nǐ hǎo, wǒ yào yì bēi kā fēi.",
          "text_translation": "Assalomu alaykum, menga bir chashka qahva bering.",
          "text_translation_ru": "Здравствуйте, мне, пожалуйста, чашку кофе.",
          "text_translation_en": "Hello, I'd like a coffee.",
          "speaker": "A"
        },
        {
          "id": "d38-s2",
          "text_original": "好的，您要热的还是冰的？",
          "pinyin": "Hǎo de, nín yào rè de hái shì bīng de?",
          "text_translation": "Xo'p bo'ladi. Issiq bo'lsinmi yoki muzlimi?",
          "text_translation_ru": "Хорошо. Вам горячий или со льдом?",
          "text_translation_en": "Certainly. Would you like it hot or iced?",
          "speaker": "B"
        },
        {
          "id": "d38-s3",
          "text_original": "热的。",
          "pinyin": "Rè de.",
          "text_translation": "Issiq bo'lsin.",
          "text_translation_ru": "Горячий.",
          "text_translation_en": "Hot, please.",
          "speaker": "A"
        },
        {
          "id": "d38-s4",
          "text_original": "大杯还是中杯？",
          "pinyin": "Dà bēi hái shì zhōng bēi?",
          "text_translation": "Katta chashkami yoki o'rtachami?",
          "text_translation_ru": "Большую или среднюю?",
          "text_translation_en": "Large or medium?",
          "speaker": "B"
        },
        {
          "id": "d38-s5",
          "text_original": "中杯就行。",
          "pinyin": "Zhōng bēi jiù xíng.",
          "text_translation": "O'rtachasi bo'lsa bo'ldi.",
          "text_translation_ru": "Средней будет достаточно.",
          "text_translation_en": "Medium is fine.",
          "speaker": "A"
        },
        {
          "id": "d38-s6",
          "text_original": "还要别的吗？",
          "pinyin": "Hái yào bié de ma?",
          "text_translation": "Yana biror narsa kerakmi?",
          "text_translation_ru": "Что-нибудь ещё?",
          "text_translation_en": "Anything else?",
          "speaker": "B"
        },
        {
          "id": "d38-s7",
          "text_original": "再要一块蛋糕。",
          "pinyin": "Zài yào yí kuài dàn gāo.",
          "text_translation": "Yana bir bo'lak tort bering.",
          "text_translation_ru": "Ещё кусочек торта.",
          "text_translation_en": "And a slice of cake, please.",
          "speaker": "A"
        },
        {
          "id": "d38-s8",
          "text_original": "好的，您稍等。",
          "pinyin": "Hǎo de, nín shāo děng.",
          "text_translation": "Xo'p bo'ladi, biroz kutib turing.",
          "text_translation_ru": "Хорошо, подождите немного.",
          "text_translation_en": "Certainly, one moment please.",
          "speaker": "B"
        },
        {
          "id": "d38-s9",
          "text_original": "请问咖啡要等多久？",
          "pinyin": "Qǐng wèn kā fēi yào děng duō jiǔ?",
          "text_translation": "Kechirasiz, qahvani qancha kutish kerak?",
          "text_translation_ru": "Скажите, пожалуйста, сколько ждать кофе?",
          "text_translation_en": "Excuse me, how long will the coffee take?",
          "speaker": "A"
        },
        {
          "id": "d38-s10",
          "text_original": "五分钟就好。",
          "pinyin": "Wǔ fēn zhōng jiù hǎo.",
          "text_translation": "Besh daqiqada tayyor bo'ladi.",
          "text_translation_ru": "Через пять минут будет готов.",
          "text_translation_en": "About five minutes.",
          "speaker": "B"
        },
        {
          "id": "d38-s11",
          "text_original": "好的，我坐那边等。",
          "pinyin": "Hǎo de, wǒ zuò nà biān děng.",
          "text_translation": "Yaxshi, men anavi yerda o'tirib kutaman.",
          "text_translation_ru": "Хорошо, я подожду вон там.",
          "text_translation_en": "All right, I'll wait over there.",
          "speaker": "A"
        },
        {
          "id": "d38-s12",
          "text_original": "好，好了我叫您。",
          "pinyin": "Hǎo, hǎo le wǒ jiào nín.",
          "text_translation": "Xo'p, tayyor bo'lganda chaqiraman.",
          "text_translation_ru": "Хорошо, как будет готово — позову.",
          "text_translation_en": "Fine, I'll call you when it's ready.",
          "speaker": "B"
        },
        {
          "id": "d38-s13",
          "text_original": "谢谢！",
          "pinyin": "Xiè xie!",
          "text_translation": "Rahmat!",
          "text_translation_ru": "Спасибо!",
          "text_translation_en": "Thank you!",
          "speaker": "A"
        },
        {
          "id": "d38-s14",
          "text_original": "不客气。",
          "pinyin": "Bú kè qi.",
          "text_translation": "Arzimaydi.",
          "text_translation_ru": "Не за что.",
          "text_translation_en": "You're welcome.",
          "speaker": "B"
        }
      ]
    }
  ]
}
